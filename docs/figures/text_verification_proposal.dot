digraph G {
 graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.55", fontname="DejaVu Sans", fontsize=20, labelloc=t, label="Proposed Text-Guided Localization Verification\nDESIGN v0.1 — NOT IMPLEMENTED OR VALIDATED\nTraining: paired localization interventions + directional repair supervision"];
 node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=12, color="#718096", penwidth=1.3, margin="0.15,0.12", fillcolor="white"];
 edge [color="#4a5568", arrowsize=0.7, penwidth=1.25, fontname="DejaVu Sans", fontsize=10];
 image [label="Medical image I\n(retina / endoscopy / X-ray)",fillcolor="#f7fafc"];
 text [label="Target text t",fillcolor="#fff5eb"];
 subgraph cluster_enc { label="1. Pretrained representations";fontname="DejaVu Sans";fontsize=15;style="rounded,dashed";color="#a0aec0";
 sam [label="SAM 2.1 image encoder\nFrozen",fillcolor="#e5f0df",color="#72965c"];
 clipimg [label="BiomedCLIP image encoder\nFrozen",fillcolor="#e1eef8",color="#6b93b5"];
 cliptext [label="BiomedCLIP text encoder\nFrozen",fillcolor="#fce9da",color="#c48b5e"];
 }
 subgraph cluster_base { label="2. Two localization paths (standard components)";fontname="DejaVu Sans";fontsize=15;style="rounded,dashed";color="#a0aec0";
 pyramid [label="SAM feature pyramid\n256² / 128² / 64²",fillcolor="#e5f0df"];
 visual [label="Visual decoder\nNo text-localization input",fillcolor="#e5f0df"];
 pv [label="Visual prediction pV",fillcolor="#e5f0df"];
 align [label="Patch–text alignment\n+ lightweight localization decoder",fillcolor="#eee5f7",color="#9575b5"];
 pt [label="Text-conditioned prior pT",fillcolor="#eee5f7"];
 }
 subgraph cluster_repair { label="3. Directional verification & repair (hypothesis)";fontname="DejaVu Sans";fontsize=15;style="rounded,dashed";color="#a77b9e";
 evidence [label="Evidence assembly\nF + pT + pV + discrepancy",fillcolor="#f6e4ee",color="#b87a9c"];
 restore [label="Recovery head R\nOperate where H = 0",fillcolor="#e6f4f1",color="#5b9a8e"];
 suppress [label="Suppression head S\nOperate where H = 1",fillcolor="#fff0df",color="#c79860"];
 compose [label="Disjoint composition\np = (1−H)R + H(1−S)\nH = stopgrad[ pT ≥ τ ]",fillcolor="#f6e4ee",color="#b87a9c"];
 }
 output [label="Final segmentation p",fillcolor="#edf2f7",penwidth=2];
 image -> sam; image -> clipimg; text -> cliptext;
 sam -> pyramid; pyramid -> visual; visual -> pv;
 clipimg -> align; cliptext -> align; pyramid -> align; align -> pt;
 pyramid -> evidence; pv -> evidence; pt -> evidence;
 evidence -> restore; evidence -> suppress; restore -> compose; suppress -> compose;
 pt -> compose [label="H",color="#9575b5"]; compose -> output;
}
